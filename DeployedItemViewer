local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local PREFIX = "di_" .. tostring(math.random(1, 999999)) .. "_"

local TRIPMINE_IMAGE_URL  = "https://raw.githubusercontent.com/SmellyExpress/Matcha-Scripts/main/SubspaceTripmine.png"
local SATCHEL_IMAGE_URL   = "https://raw.githubusercontent.com/SmellyExpress/Matcha-Scripts/main/Satchel.png"
local GRENADE_IMAGE_URL   = "https://raw.githubusercontent.com/SmellyExpress/Matcha-Scripts/main/Grenade.png"
local FLASHBANG_IMAGE_URL = "https://raw.githubusercontent.com/SmellyExpress/Matcha-Scripts/main/Flashbang.png"
local MOLOTOV_IMAGE_URL   = "https://raw.githubusercontent.com/SmellyExpress/Matcha-Scripts/main/Molotov.png"

local ITEM_TYPES = {
	["SubspaceTripmineHitbox"] = {
		display = "tripmine",
		imageUrl = TRIPMINE_IMAGE_URL,
	},
	["FakeSatchelModel"] = {
		display = "satchel",
		imageUrl = SATCHEL_IMAGE_URL,
		preferredChild = "SatchelEntityHitbox",
	},
	["Flashbang"] = {
		display = "flashbang",
		imageUrl = FLASHBANG_IMAGE_URL,
		preferredChild = "Primary",
	},
	["Molotov"] = {
		display = "molotov",
		imageUrl = MOLOTOV_IMAGE_URL,
		preferredChild = "Primary",
	},
	["Grenade"] = {
		display = "grenade",
		imageUrl = GRENADE_IMAGE_URL,
		preferredChild = "Primary",
	},
}

local drawings = { texts = {}, images = {} }
local maxItems = 50
local activeItems = {}
local scanTimer = 0
local SCAN_INTERVAL = 0.25

local imageCache = {}
local slotLastUrl = {}
local slotDataSet = {}

local function getBool(key, default)
	local v = UI.GetValue(key)
	if v == nil then return default end
	return v
end

local function getNum(key, default)
	local v = UI.GetValue(key)
	if v == nil then return default end
	return v
end

local function initializeDrawingPool()
	for i = 1, maxItems do
		local t = Drawing.new("Text")
		t.Visible = false
		t.Outline = true
		t.Center = true
		t.Color = Color3.fromRGB(255, 255, 255)

		local img = Drawing.new("Image")
		img.Visible = false
		img.Size = Vector2.new(32, 32)

		drawings.texts[i] = t
		drawings.images[i] = img
		slotDataSet[i] = false
	end
end

local function getImageData(url)
	if imageCache[url] then return imageCache[url] end

	local ok, data = pcall(function() return game:HttpGet(url) end)
	if ok and data and #data > 0 then
		imageCache[url] = data
		return data
	end

	return nil
end

local function preloadImages()
	for _, info in pairs(ITEM_TYPES) do
		if info.imageUrl then
			getImageData(info.imageUrl)
		end
	end
end

local function ensureSlotData(slotIndex, imgObj, url)
	local data = getImageData(url)
	if not data then return false end

	if slotDataSet[slotIndex] and slotLastUrl[slotIndex] == url then
		return true
	end

	imgObj.Data = data
	slotLastUrl[slotIndex] = url
	slotDataSet[slotIndex] = true
	return true
end

local function hasPosition(obj)
	if not obj then return false end
	return typeof(obj.Position) == "Vector3"
end

local function resolvePart(instance, preferredChild)
	if hasPosition(instance) then
		return instance
	end

	if instance.ClassName == "Model" then
		if preferredChild then
			local pref = instance:FindFirstChild(preferredChild)
			if hasPosition(pref) then return pref end
		end

		local hb = instance:FindFirstChild("Hitbox")
		if hasPosition(hb) then return hb end

		if hasPosition(instance.PrimaryPart) then
			return instance.PrimaryPart
		end

		local any = instance:FindFirstChildWhichIsA("BasePart")
		if hasPosition(any) then return any end
	end

	return nil
end

local function rescanForItems()
	local found = {}

	for _, child in ipairs(Workspace:GetChildren()) do
		local info = ITEM_TYPES[child.Name]
		if info then
			local part = resolvePart(child, info.preferredChild)
			if hasPosition(part) and part.Parent then
				table.insert(found, {
					part = part,
					display = info.display,
					imageUrl = info.imageUrl,
				})
				if #found >= maxItems then break end
			end
		end
	end

	activeItems = found
end

local function drawActiveItems()
	for i = 1, maxItems do
		local textObj = drawings.texts[i]
		local imgObj = drawings.images[i]
		local entry = activeItems[i]

		if not entry or not hasPosition(entry.part) or not entry.part.Parent then
			textObj.Visible = false
			imgObj.Visible = false
		else
			local pos = entry.part.Position
			local screenPos, onScreen = WorldToScreen(pos)

			if not onScreen then
				textObj.Visible = false
				imgObj.Visible = false
			else
				local scale = getNum(PREFIX .. "image_scale", 1.0)
				local size = 32 * scale

				local showImage = false
				if getBool(PREFIX .. "image_enabled", true) and entry.imageUrl then
					showImage = ensureSlotData(i, imgObj, entry.imageUrl)
				end

				local textYOffset
				if showImage then
					imgObj.Size = Vector2.new(size, size)
					imgObj.Position = screenPos - Vector2.new(size / 2, size + 10)
					imgObj.Visible = true
					textYOffset = -(size + 10) - 20
				else
					imgObj.Visible = false
					textYOffset = -30
				end

				if getBool(PREFIX .. "text_enabled", true) then
					textObj.Text = entry.display
					textObj.Size = math.floor(14 * getNum(PREFIX .. "text_scale", 1.0))
					textObj.Position = screenPos + Vector2.new(0, textYOffset)
					textObj.Visible = true
				else
					textObj.Visible = false
				end
			end
		end
	end
end

local function hideAllDrawings()
	for i = 1, maxItems do
		drawings.texts[i].Visible = false
		drawings.images[i].Visible = false
	end
end

local function onRenderStep(dt)
	if not getBool(PREFIX .. "esp_enabled", true) then
		hideAllDrawings()
		return
	end

	scanTimer += dt
	if scanTimer >= SCAN_INTERVAL then
		scanTimer = 0
		rescanForItems()
	end

	drawActiveItems()
end

pcall(function() UI.RemoveTab("Deployed Items") end)

UI.AddTab("Deployed Items", function(tab)
	local main = tab:Section("Settings", "Left")

	main:Toggle(PREFIX .. "esp_enabled", "Enabled", true)

	main:Text("Text Settings")
	main:Toggle(PREFIX .. "text_enabled", "Show Names", true)
	main:SliderFloat(PREFIX .. "text_scale", "Text Scale", 0.5, 3.0, 1.0, "%.1f")

	main:Spacing()
	main:Text("Image Settings")
	main:Toggle(PREFIX .. "image_enabled", "Show Images", true)
	main:SliderFloat(PREFIX .. "image_scale", "Image Scale", 0.5, 3.0, 1.0, "%.1f")
end)

initializeDrawingPool()
preloadImages()
RunService.RenderStepped:Connect(onRenderStep)
